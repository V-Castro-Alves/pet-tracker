<% content_for :title, "Create account" %>

<section class="auth-card">
  <p class="eyebrow">Start caring together</p>
  <h1>Create your account</h1>
  <p class="muted">Track meals, supplies, and health records with everyone who cares for your pet.</p>

  <%= form_with model: @user, url: registration_path do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :time_zone %>
      <%= form.time_zone_select :time_zone, nil, {}, required: true %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Create account", class: "button button-primary" %>
  <% end %>

  <p class="auth-switch">Already registered? <%= link_to "Sign in", new_session_path %></p>
</section>
