<section class="dashboard-section push-settings" data-controller="push-notifications" data-push-notifications-public-key-value="<%= (ENV["VAPID_PUBLIC_KEY"] if ENV["VAPID_PRIVATE_KEY"].present?) %>" data-push-notifications-create-url-value="<%= push_subscriptions_path %>" data-push-notifications-destroy-url-value="<%= push_subscription_path("current") %>">
  <div><h2>Device notifications</h2><p class="muted" role="status" aria-live="polite" data-push-notifications-target="status">Checking this device…</p></div>
  <button type="button" class="button button-secondary" data-action="push-notifications#open">Device notification settings</button>
  <button type="button" class="button button-secondary" data-push-notifications-target="disable" data-action="push-notifications#disable" hidden>Disable push</button>
  <dialog data-push-notifications-target="dialog" aria-labelledby="push-dialog-title">
    <h2 id="push-dialog-title">Receive notifications on this device</h2>
    <p>Activate push notifications to receive reminders when Household is closed. Your in-app notifications remain available without push.</p>
    <p role="status" aria-live="polite" data-push-notifications-target="status">Checking this device…</p>
    <button type="button" class="button button-primary" data-push-notifications-target="enable" data-action="push-notifications#enable" disabled>Activate notifications</button>
    <button type="button" class="button button-secondary" data-action="push-notifications#close">Not now</button>
  </dialog>
</section>
