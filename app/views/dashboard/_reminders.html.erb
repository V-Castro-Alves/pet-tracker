<div class="reminder-list">
  <% reminders.each do |reminder| %>
    <article class="reminder-card <%= "reminder-due" if due %>">
      <%= link_to reminder.pet, class: "reminder-pet", aria: { label: "View #{reminder.pet.name}" } do %>
        <% if reminder.pet.photo.attached? %>
          <%= image_tag reminder.pet.photo.variant(resize_to_limit: [160, 160]), alt: "", class: "reminder-photo" %>
        <% else %>
          <span class="reminder-photo pet-photo-placeholder"><%= render "shared/paw" %></span>
        <% end %>
      <% end %>
      <div class="reminder-copy">
        <p class="eyebrow"><%= reminder.pet.name %></p>
        <h3><%= reminder.meal_slot.name %></h3>
        <p><%= number_with_precision(reminder.meal_slot.default_amount_g, precision: 0, strip_insignificant_zeros: true) %> g · Meal <%= reminder.scheduled_for.in_time_zone(Current.user.time_zone).strftime("%b %-d, %H:%M") %></p>
        <p class="reminder-time"><%= due ? "Reminder" : "Remind me" %> <time datetime="<%= reminder.due_at.iso8601 %>"><%= reminder.due_at.in_time_zone(Current.user.time_zone).strftime("%b %-d, %H:%M") %></time></p>
      </div>
      <%= link_to "Log meal", new_pet_meal_log_path(reminder.pet, meal_slot_id: reminder.meal_slot.id, date: reminder.scheduled_for.in_time_zone(reminder.pet.time_zone).to_date.iso8601), class: "button #{due ? 'button-primary' : 'button-secondary'} button-fit", aria: { label: "Log #{reminder.pet.name} #{reminder.meal_slot.name}" } %>
    </article>
  <% end %>
</div>
