<% if @households.any? %>
<h1>Today</h1>
<%= form_with url: root_path, method: :get do |form| %><%= form.label :household_id, "Household" %><%= form.select :household_id, @households.map { |household| [household.name, household.public_id] }, include_blank: "All households", selected: params[:household_id] %><%= form.label :view, "Responsibilities" %><%= form.select :view, [["Everyone", "everyone"], ["Mine", "mine"]], selected: params[:view] %><%= form.submit "Filter" %><% end %>
<% @groups.each do |label, occurrences| %><section><h2><%= label %></h2><% if occurrences.empty? %><p>No tasks here.</p><% end %><% occurrences.each do |occurrence| %>
<article class="card" data-controller="task-action"><h3><%= occurrence.task.title %></h3><p><%= occurrence.task.household.name %> · <%= occurrence.scheduled_at.in_time_zone(Current.user.time_zone).strftime("%b %d, %H:%M") %> · <%= occurrence.assignee&.name || "Anyone" %></p>
<%= render "tasks/completion_details", occurrence: occurrence %>
<% %w[completed skipped].each do |status| %><button data-action="task-action#resolve" data-status="<%= status %>" data-url="<%= api_v1_household_occurrence_path(occurrence.task.household, occurrence) %>"><%= status == "completed" ? "Complete" : "Skip" %></button><% end %><p role="status" data-task-action-target="message"></p></article>
<% end %></section><% end %>
<h2>Recent activity</h2><% @activity.each do |item| %><p><%= item.task.title %> — <%= item.status %> by <%= item.credited_user&.name %></p><% end %>
<% else %>
<section class="card"><h1>Share the everyday work.</h1><h2>Create your first household</h2><p>Bring chores, reminders, and optional pet care together.</p><%= link_to "Create your household", new_household_path, class: "button" %></section>
<%= render "legacy" if @pets.any? %>
<% end %>
