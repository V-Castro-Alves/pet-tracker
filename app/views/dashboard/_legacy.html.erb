<% content_for :title, "Today" %>
<section class="page-header today-header">
  <div>
    <p class="eyebrow"><%= @now.in_time_zone(Current.user.time_zone).strftime("%A, %B %-d") %></p>
    <h1>A little care for today.</h1>
    <p class="page-intro">Your pets’ meal reminders, together in one place.</p>
  </div>
</section>

<% if @pets.any? %>
  <section class="reminder-section" aria-labelledby="due-heading">
    <div class="section-title"><h2 id="due-heading">Needs attention</h2><span><%= @due_reminders.size %> pending</span></div>
    <% if @due_reminders.any? %>
      <%= render "reminders", reminders: @due_reminders, due: true %>
    <% else %>
      <div class="care-clear"><span class="care-check" aria-hidden="true">✓</span><div><h3>You’re all caught up</h3><p>No meal reminders need attention right now.</p></div></div>
    <% end %>
  </section>
  <section class="reminder-section" aria-labelledby="upcoming-heading">
    <div class="section-title"><h2 id="upcoming-heading">Later today</h2><span><%= @upcoming_reminders.size %> upcoming</span></div>
    <% if @upcoming_reminders.any? %>
      <%= render "reminders", reminders: @upcoming_reminders, due: false %>
    <% else %>
      <p class="muted">No more meal reminders scheduled for today.</p>
    <% end %>
  </section>
  <p class="reminder-footnote">Times shown in <%= Current.user.time_zone %>. This list follows your personal reminder settings and hides meals already fed or skipped. Pending reminders stay here for up to 24 hours after their reminder time.</p>
  <%= link_to "View your pets & manage routines", pets_path, class: "button button-secondary" %>
<% else %>
  <%= render "shared/pet_list", pets: @pets %>
<% end %>
