<section class="page-header dashboard-hero">
  <div>
    <p class="eyebrow">Your care space</p>
    <h1>Good care starts here.</h1>
    <p class="page-intro">Meals, health, and the little details that keep your companions thriving.</p>
  </div>
  <%= link_to new_pet_path, class: "button button-primary button-fit" do %><span aria-hidden="true">＋</span> Add pet<% end %>
</section>

<% if pets.any? %>
  <div class="section-title"><h2>Your pets</h2><span><%= pluralize(pets.size, "companion") %></span></div>
  <div class="pet-grid">
    <% pets.each do |pet| %>
      <%= link_to pet, class: "pet-card" do %>
        <% if pet.photo.attached? %>
          <%= image_tag pet.photo.variant(resize_to_fill: [320, 220]), alt: "", class: "pet-card-photo" %>
        <% else %>
          <div class="pet-card-photo pet-photo-placeholder" aria-hidden="true">🐾</div>
        <% end %>
        <div class="pet-card-body">
          <h2><%= pet.name %></h2>
          <p><%= pet.species %><%= " · #{pet.breed}" if pet.breed.present? %></p>
          <span class="card-link">Open profile <span aria-hidden="true">→</span></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-state-icon" aria-hidden="true">🐾</div>
    <h2>Add your first pet</h2>
    <p>Once your pet is here, you can create a feeding schedule and invite other caretakers.</p>
    <%= link_to "Add a pet", new_pet_path, class: "button button-primary button-fit" %>
  </section>
<% end %>
