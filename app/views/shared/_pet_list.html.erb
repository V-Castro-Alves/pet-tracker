<% if pets.any? %>
  <section class="page-header">
    <div><p class="eyebrow">Your companions</p><h1>Your pets</h1><p class="page-intro">Profiles, routines, and care settings.</p></div>
    <%= link_to "Add pet", new_pet_path, class: "quiet-add" %>
  </section>
  <div class="pet-grid">
    <% pets.each do |pet| %>
      <%= link_to pet, class: "pet-card" do %>
        <% if pet.photo.attached? %>
          <%= image_tag pet.photo.variant(resize_to_limit: [320, 320]), alt: "", class: "pet-card-photo" %>
        <% else %>
          <div class="pet-card-photo pet-photo-placeholder" aria-hidden="true"><%= render "shared/paw" %></div>
        <% end %>
        <div class="pet-card-body">
          <h2><%= pet.name %></h2>
          <p><%= pet.species %><%= " · #{pet.breed}" if pet.breed.present? %></p>
          <span class="card-link">Open profile <span aria-hidden="true">→</span></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-state-icon" aria-hidden="true"><%= render "shared/paw" %></div>
    <h2>Add your first pet</h2>
    <p>Once your pet is here, you can create a feeding schedule and invite other caretakers.</p>
    <%= link_to "Add a pet", new_pet_path, class: "button button-primary button-fit" %>
  </section>
<% end %>
