<h1><%= @pet.name %> feeding</h1>
<%= link_to "Manage feeding tasks", household_tasks_path(@pet.household) %>
<% @occurrences.each do |occurrence| %><article class="card" data-controller="task-action"><h2><%= occurrence.task.title %></h2><p><%= occurrence.scheduled_at.in_time_zone(Current.user.time_zone).strftime("%b %d, %H:%M") %> · <%= occurrence.task.feeding_amount_g %> g</p><%= render "tasks/completion_details", occurrence: occurrence %><button data-action="task-action#resolve" data-status="completed" data-url="<%= api_v1_household_occurrence_path(@pet.household, occurrence) %>">Record feeding</button><button data-action="task-action#resolve" data-status="skipped" data-url="<%= api_v1_household_occurrence_path(@pet.household, occurrence) %>">Skip</button><p role="status" data-task-action-target="message"></p></article><% end %>
<h2>Additional feeding</h2><p>Use this only for a separate feeding beyond the scheduled meal.</p>
<%= form_with url: pet_meal_logs_path(@pet), class: "household-form" do |form| %><%= hidden_field_tag :additional_feeding, "1" %><%= label_tag "feeding_amount_g", "Amount (grams)" %><%= number_field_tag "feeding[amount_g]", nil, id: "feeding_amount_g", min: 0.01, step: 0.01, required: true %><%= form.submit "Record additional feeding" %><% end %>
<h2>Feeding history</h2><% @feedings.each do |entry| %><p><%= entry.fed_at.in_time_zone(Current.user.time_zone).strftime("%b %d, %H:%M") %> — <%= entry.amount_g %> g by <%= entry.credited_user.name %><%= " (additional feeding)" unless entry.task_occurrence_id %></p><% end %>
