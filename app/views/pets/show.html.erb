<% content_for :title, @pet.name %>
<section class="pet-hero">
  <% if @pet.photo.attached? %>
    <%= image_tag @pet.photo.variant(resize_to_fill: [240, 240]), class: "pet-photo", alt: @pet.name %>
  <% else %>
    <div class="pet-photo pet-photo-placeholder" aria-hidden="true">🐾</div>
  <% end %>
  <div>
    <p class="eyebrow"><%= @pet.species %><%= " · #{@pet.breed}" if @pet.breed.present? %></p>
    <h1><%= @pet.name %></h1>
    <p class="muted"><%= @pet.time_zone %></p>
    <%= link_to "Edit profile", edit_pet_path(@pet), class: "button button-secondary" %>
    <%= link_to "Meal QR code", pet_qr_code_path(@pet), class: "button button-secondary" %>
    <%= link_to "Caretakers", pet_pet_users_path(@pet), class: "button button-secondary" %>
  </div>
</section>

<section class="health-grid page-action">
  <article class="dashboard-section">
    <div class="section-heading"><div><p class="eyebrow">Health</p><h2>Weight</h2></div><%= link_to "History", pet_weight_logs_path(@pet) %></div>
    <% if (weight = @pet.weight_logs.chronological.first) %><p><strong><%= number_with_precision(weight.weight_kg, precision: 2, strip_insignificant_zeros: true) %> kg</strong><br><span class="muted"><%= l weight.logged_at, format: :long %></span></p><% else %><p class="muted">No weight recorded.</p><% end %>
  </article>
  <article class="dashboard-section">
    <div class="section-heading"><div><p class="eyebrow">Health</p><h2>Vaccines</h2></div><%= link_to "Records", pet_vaccines_path(@pet) %></div>
    <% alert_vaccines = @pet.vaccines.select { |vaccine| vaccine.due_status.in?(%i[due_soon overdue]) } %>
    <% if alert_vaccines.any? %><p><strong><%= pluralize(alert_vaccines.count, "vaccine") %> need attention</strong></p><% else %><p class="muted">No upcoming vaccine alerts.</p><% end %>
  </article>
  <article class="dashboard-section">
    <div class="section-heading"><div><p class="eyebrow">Health</p><h2>Medical history</h2></div><%= link_to "Journal", pet_medical_entries_path(@pet) %></div>
    <% if (entry = @pet.medical_entries.chronological.first) %><p><strong><%= entry.title.presence || "Medical note" %></strong><br><span class="muted"><%= l entry.entry_date, format: :long %></span></p><% else %><p class="muted">No medical entries.</p><% end %>
  </article>
</section>

<section class="dashboard-section page-action">
  <div class="section-heading">
    <div><p class="eyebrow">Supplies</p><h2>Food inventory</h2></div>
    <%= link_to "View inventory", pet_food_bags_path(@pet) %>
  </div>
  <% if (bag = @pet.active_food_bag) %>
    <p><strong><%= number_with_precision(bag.remaining_weight_g, precision: 0, strip_insignificant_zeros: true) %> g remaining</strong><%= " · running low" if bag.low_stock? %></p>
  <% else %>
    <p class="muted">No active food bag.</p>
    <%= link_to "Start a bag", new_pet_food_bag_path(@pet), class: "button button-secondary" %>
  <% end %>
</section>

<section class="dashboard-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Daily routine</p>
      <h2>Meal schedule</h2>
    </div>
    <%= link_to "Manage schedule", pet_meal_slots_path(@pet) %>
  </div>
  <% if @pet.meal_slots.active.any? %>
    <div class="compact-slots">
      <% @pet.meal_slots.active.chronological.each do |slot| %>
        <span><strong><%= slot.scheduled_time.strftime("%H:%M") %></strong> <%= slot.name %> · <%= number_with_precision(slot.default_amount_g, precision: 0, strip_insignificant_zeros: true) %> g</span>
      <% end %>
    </div>
    <div class="dashboard-actions">
      <%= link_to "Log now", new_pet_meal_log_path(@pet), class: "button button-primary button-fit" %>
      <%= link_to "View history", pet_meal_logs_path(@pet), class: "button button-secondary" %>
    </div>
  <% else %>
    <p class="muted">No feeding times yet.</p>
    <%= link_to "Set up meals", new_pet_meal_slot_path(@pet), class: "button button-primary button-fit" %>
  <% end %>
</section>
