<% content_for :title, "My reminders for #{@meal_slot.name}" %>
<section class="content-card">
  <h1>My reminders for <%= @meal_slot.name %></h1>
  <p>Meal time: <%= @meal_slot.scheduled_time.strftime("%H:%M") %> (<%= @pet.time_zone %>). Weekdays follow the meal's date in this time zone, even when a delay runs past midnight. Reminders stop once the meal is logged as fed or skipped.</p>
  <%= render "notifications/device_settings" %>
  <%= form_with scope: :reminder_preference, url: pet_meal_slot_reminder_path(@pet, @meal_slot), method: :patch do |form| %>
    <%= render "shared/form_errors", record: @reminder_preference %>
    <% [1, 2, 3, 4, 5, 6, 0].each do |day| %>
      <fieldset data-controller="reminder-timing">
        <legend><%= MealReminderPreference::WEEKDAYS[day] %></legend>
        <div class="field">
          <%= label_tag "timing_#{day}", "#{MealReminderPreference::WEEKDAYS[day]} notifications" %>
          <%= select_tag "reminder_preference[weekdays][#{day}][timing]", options_for_select(MealReminderPreference::TIMING_OPTIONS, @reminder_preference.weekday_timing(day)), id: "timing_#{day}", data: { reminder_timing_target: "timing", action: "reminder-timing#change" } %>
        </div>
        <div class="field" data-reminder-timing-target="custom">
          <%= label_tag "minutes_#{day}", "#{MealReminderPreference::WEEKDAYS[day]} custom delay (minutes)" %>
          <%= number_field_tag "reminder_preference[weekdays][#{day}][minutes]", @reminder_preference.weekday_delay(day), id: "minutes_#{day}", min: 0, max: 1440, step: 1 %>
        </div>
      </fieldset>
    <% end %>
    <%= form.submit "Save my reminders", class: "button button-primary" %>
    <%= link_to "Back to schedule", pet_meal_slots_path(@pet) %>
  <% end %>
</section>
