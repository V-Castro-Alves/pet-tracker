# syntax=docker/dockerfile:1
ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libssl-dev libyaml-dev pkg-config libvips sqlite3 tzdata && \
    rm -rf /var/lib/apt/lists/*

ENV RAILS_ENV=development \
    BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

# Match the host user so bind-mounted databases and uploads stay writable.
ARG UID=1000
ARG GID=1000
RUN groupadd --gid "${GID}" rails && \
    useradd --uid "${UID}" --gid "${GID}" --create-home rails
USER rails

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
